---
// Block 12 — "Multi-Platform Integration": copy + platform logo tiles, then three feature
// cards (Generate / Personalize / Sell). The Personalize card runs a horizontal image ticker.
// Note: on the original the three cards collapse to 0px height below 1200px (Framer layout
// quirk); that is reproduced so the block height and the following section line up.
interface Media {
  type: 'image' | 'ticker';
  src?: string;
  alt?: string;
  duration?: number;
  copies?: number;
  items?: { src: string; alt: string }[];
}
interface Props {
  content: {
    ref: string;
    title: string;
    lead: string;
    platforms: { name: string; icon: string }[];
    cards: { title: string; text: string; media: Media }[];
  };
}
const { content } = Astro.props;
const ITEM_W = 355; // ticker tile width (px)
const GAP = 10; // ticker gap (px)
---
<section class="intg" data-ref={content.ref}>
  <div class="intg__top">
    <div class="intg__copy">
      <h2 class="intg__title">{content.title}</h2>
      <p class="intg__lead">{content.lead}</p>
    </div>
    <ul class="intg__logos">
      {content.platforms.map((p) => (
        <li class="intg__logo"><img src={p.icon} alt={p.name} width="100" height="100" loading="lazy" decoding="async" /></li>
      ))}
    </ul>
  </div>

  <div class="intg__cards-wrap">
    <ul class="intg__cards">
      {content.cards.map((card) => (
        <li class="intg__card">
          {card.media.type === 'ticker' ? (
            <div class="intg__media intg__media--ticker">
              <div class="intg__ticker">
                <ul
                  class="intg__ticker-track"
                  style={`--shift:${-(card.media.items!.length * (ITEM_W + GAP))}px;--dur:${card.media.duration}s;`}
                >
                  {Array.from({ length: card.media.copies ?? 3 }).flatMap((_, copy) =>
                    card.media.items!.map((it) => (
                      <li aria-hidden={copy > 0 ? 'true' : undefined}>
                        <div class="intg__tile">
                          <img src={it.src} alt={copy > 0 ? '' : it.alt} loading="lazy" decoding="async" />
                        </div>
                      </li>
                    )),
                  )}
                </ul>
              </div>
            </div>
          ) : (
            <div class="intg__media">
              <img class="intg__mock" src={card.media.src} alt={card.media.alt} loading="lazy" decoding="async" />
            </div>
          )}
          <div class="intg__card-body">
            <h3 class="intg__card-title">{card.title}</h3>
            <p class="intg__card-text">{card.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intg {
    position: relative; width: 100%; max-width: 1440px; margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px;
    padding: 200px 51px 80px;
  }

  /* ---- top row: copy + logos ---- */
  .intg__top { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 0; width: 100%; }
  .intg__copy {
    flex: 1 0 0; width: 1px; display: flex; flex-direction: column; justify-content: center; gap: 10px; overflow: hidden;
  }
  .intg__title {
    font-family: var(--f-medium); font-weight: 400; font-size: 54.03px; line-height: 67.2px;
    letter-spacing: -0.03em; color: #fff; white-space: pre-wrap; overflow-wrap: break-word;
  }
  .intg__lead {
    font-family: var(--f-medium); font-weight: 400; font-size: 19.53px; line-height: 30px;
    color: rgb(176, 176, 176); overflow-wrap: break-word;
  }
  .intg__logos {
    flex: none; width: 58%; height: 283px; display: flex; flex-direction: row; align-items: center; justify-content: center;
    gap: 20px; padding: 0 20px; background: rgb(16, 16, 16); border-radius: 20px; overflow: hidden;
  }
  .intg__logo { flex: none; width: 100px; height: 100px; }
  .intg__logo img { width: 100%; height: 100%; }

  /* ---- cards ---- */
  .intg__cards-wrap { display: flex; width: 100%; overflow: hidden; }
  .intg__cards { flex: 1 0 0; width: 1px; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 30px; }
  .intg__card {
    position: relative; flex: 1 0 0; width: 1px; align-self: stretch;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: rgb(15, 15, 15); border-radius: 11px; overflow: hidden;
  }
  .intg__card::after {
    content: ""; position: absolute; inset: 0; border: 0.6703px solid #000; border-radius: inherit; pointer-events: none;
  }
  .intg__media {
    position: relative; flex: none; width: 100%; height: 228px; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    background: rgb(25, 25, 25);
  }
  .intg__mock { height: 100%; width: auto; aspect-ratio: 1.4581 / 1; object-fit: contain; }

  .intg__media--ticker { justify-content: center; }
  .intg__ticker {
    display: flex; align-items: center; width: 100%; height: 100%; padding: 10px; overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, #000 12.5%, #000 87.5%, rgba(0,0,0,0) 100%);
    mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, #000 12.5%, #000 87.5%, rgba(0,0,0,0) 100%);
  }
  .intg__ticker-track {
    position: relative; display: flex; flex-direction: row; align-items: center; gap: 10px;
    width: 100%; height: 100%; will-change: transform;
  }
  .intg__ticker-track > li { flex: none; }
  .intg__tile { position: relative; width: 355px; aspect-ratio: 1.04545 / 1; flex-shrink: 0; }
  .intg__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  html:not(.no-motion) .intg__ticker-track { animation: intg-ticker var(--dur) linear infinite; }
  @keyframes intg-ticker { from { transform: translateX(0); } to { transform: translateX(var(--shift)); } }
  @media (prefers-reduced-motion: reduce) { html:not(.no-motion) .intg__ticker-track { animation: none; } }

  .intg__card-body {
    flex: none; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px; padding: 40px;
  }
  .intg__card-title {
    width: 100%; font-family: var(--f-medium); font-weight: 400; font-size: 25.76px; line-height: 32.17px;
    letter-spacing: -0.54px; color: #fff; overflow-wrap: break-word;
  }
  .intg__card-text {
    width: 100%; font-family: var(--f-medium); font-weight: 400; font-size: 11.69px; line-height: 18.1px;
    color: rgb(104, 104, 104); overflow-wrap: break-word;
  }

  /* laptop */
  @media (min-width: 1200px) and (max-width: 1439px) {
    .intg { padding: 200px 40px 80px; }
  }

  /* tablet */
  @media (min-width: 810px) and (max-width: 1199px) {
    .intg { padding: 200px 40px 40px; }
    .intg__top { flex-direction: column; gap: 30px; }
    .intg__copy { flex: none; width: 100%; gap: 20px; }
    .intg__logos { width: 100%; }
    .intg__logo { width: 150px; height: 150px; }
    .intg__cards { flex-direction: column; }
    .intg__card { flex: none; align-self: auto; width: 100%; height: 0; }
    .intg__card-body { align-items: flex-start; }
    .intg__card-title, .intg__card-text { width: auto; white-space: pre; text-align: center; }
  }

  /* mobile */
  @media (max-width: 809px) {
    .intg { padding: 100px 15px 0; }
    .intg__top { flex-direction: column; }
    .intg__copy { flex: none; width: 100%; padding: 37px 0; }
    .intg__title { font-size: 40px; line-height: 50px; }
    .intg__logos { width: 100%; height: auto; flex-direction: column; gap: 37px; padding: 40px 20px; }
    .intg__logo { width: 194px; height: 194px; }
    .intg__cards { flex-direction: column; }
    .intg__card { flex: none; align-self: auto; width: 100%; height: 0; }
  }
</style>
