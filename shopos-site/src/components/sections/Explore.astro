---
// Original block 04: "Explore" light panel with a pink→purple glow, three columns of
// prompt/result cards (2 columns on tablet, 1 stacked column on mobile).
interface Media {
  type: 'image' | 'video'; src: string; radius: number; fit: string;
  size?: number[]; fill?: boolean; srcset?: string; sizes?: string; sizeM?: number[]; fitM?: string;
}
interface Card { prompt: string; bubble: { src: string; h: number }; media: Media }
interface Props {
  content: {
    ref: string; title: string; subtitle: string;
    columns: { show: string[]; cards: Card[] }[];
  };
}
const { content } = Astro.props;
const mediaStyle = (m: Media) => {
  const s = [`--r:${m.radius}px`, `--fit:${m.fit}`];
  if (m.size) s.push(`--w:${m.size[0]}px`, `--h:${m.size[1]}px`);
  if (m.sizeM) s.push(`--wm:${m.sizeM[0]}px`, `--hm:${m.sizeM[1]}px`);
  if (m.fitM) s.push(`--fitm:${m.fitM}`);
  return s.join(';');
};
---
<section class="explore" data-ref={content.ref}>
  <div class="explore__fade" aria-hidden="true"></div>
  <div class="explore__bg" aria-hidden="true">
    <div class="explore__glow"></div>
    <div class="explore__panel"></div>
  </div>

  <h2 class="explore__title">{content.title}</h2>
  <p class="explore__sub">{content.subtitle}</p>

  <div class="explore__cols">
    {content.columns.map((col, ci) => (
      <ul class={`explore__col explore__col--${ci + 1} ${col.show.map((bp) => `show-${bp}`).join(' ')}`}>
        {col.cards.map((card) => (
          <li class="explore__card">
            <div class="explore__frame">
              <div class={`explore__inner${card.media.fill ? ' explore__inner--fill' : ''}`}>
                {card.media.type === 'video' ? (
                  <video class="explore__media" style={mediaStyle(card.media)} src={card.media.src}
                    muted loop playsinline autoplay preload="metadata" data-autoplay aria-hidden="true"></video>
                ) : (
                  <img class="explore__media" style={mediaStyle(card.media)} src={card.media.src} srcset={card.media.srcset} sizes={card.media.sizes} alt="" />
                )}
              </div>
            </div>
            <div class="explore__bubble" style={`height:${card.bubble.h}px`}>
              <img src={card.bubble.src} alt={card.prompt} />
            </div>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .explore {
    position: relative; z-index: 2; width: 100%; height: 1669px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    padding: 40px; border-radius: 100px;
  }
  .explore__fade {
    position: absolute; left: 0; top: -272px; width: 100%; height: 162px; z-index: 4; pointer-events: none;
    background-image: linear-gradient(rgba(84, 84, 84, 0) 0%, rgb(0, 0, 0) 50%, rgba(0, 0, 0, 0) 100%);
  }
  .explore__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .explore__glow {
    position: absolute; inset: 0; border-radius: 50px; filter: blur(100px);
    background-image: linear-gradient(90deg, rgb(253, 82, 200) 0%, rgb(106, 78, 255) 100%);
  }
  .explore__panel {
    position: absolute; inset: 0; border-radius: 60px; background: var(--c-light-bg);
    box-shadow: rgba(0, 0, 0, 0.25) 0px 1px 2px 0px;
  }

  .explore__title, .explore__sub, .explore__cols { position: relative; z-index: 1; width: 100%; text-align: center; }
  .explore__title {
    font-family: var(--f-medium); font-weight: 400; font-size: 90px; line-height: 103.5px; letter-spacing: -2.7px; color: var(--c-ink);
  }
  .explore__sub {
    font-family: var(--f-regular); font-size: 20px; line-height: 28px; letter-spacing: -0.4px; color: rgb(130, 126, 126);
  }

  .explore__cols { display: flex; justify-content: center; align-items: center; gap: 60px; overflow: hidden; flex-shrink: 0; }
  .explore__col { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 60px; overflow: hidden; }
  .explore__col:not(.show-d) { display: none; }
  .explore__col--2 { padding-top: 90px; }

  .explore__card { width: 100%; display: flex; flex-direction: column; gap: 10px; }
  .explore__frame { height: 267px; padding: 10px; border-radius: 9px; background: rgb(227, 225, 225); }
  .explore__inner {
    position: relative; height: 247px; border-radius: 7px; background: rgb(242, 242, 242);
    display: flex; justify-content: center; align-items: center;
  }
  .explore__inner--fill { padding: 20px; }
  .explore__media {
    flex-shrink: 0; width: var(--w); height: var(--h); object-fit: var(--fit); border-radius: var(--r); display: block;
  }
  .explore__inner--fill .explore__media { width: 100%; height: 100%; }
  .explore__bubble { position: relative; width: 100%; }
  .explore__bubble img { width: 100%; height: 100%; object-fit: contain; }

  @media (min-width: 1200px) and (max-width: 1439px) {
    .explore__col:not(.show-l) { display: none; }
    .explore__col.show-l { display: flex; }
  }

  @media (min-width: 810px) and (max-width: 1199px) {
    .explore__cols { padding-top: 60px; }
    .explore__col:not(.show-t) { display: none; }
    .explore__col.show-t { display: flex; }
    .explore__col--2 { padding-top: 0; }
  }

  @media (max-width: 809px) {
    .explore { height: auto; gap: 20px; border-radius: 20px; }
    .explore__panel { border-radius: 40px; }
    .explore__title { font-size: 40px; line-height: 46px; letter-spacing: -1.2px; }
    .explore__cols { flex-direction: column; }
    .explore__col { flex: none; width: 100%; }
    .explore__col:not(.show-m) { display: none; }
    .explore__col.show-m { display: flex; }
    .explore__col--2 { padding-top: 0; }
    .explore__media { width: var(--wm, var(--w)); height: var(--hm, var(--h)); object-fit: var(--fitm, var(--fit)); }
  }
</style>
