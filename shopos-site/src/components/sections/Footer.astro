---
// Footer — original blocks 22 (social dock), 23 (full-width hairline) and 24 (copyright).
// Dock hover (Framer spring, damping 60 / mass 2 / stiffness 400): the hovered button grows
// 48 → 72px and lifts, a white indicator dot appears under it and the label tooltip fades in
// above it while sliding up 20px.
interface Social { label: string; href?: string; link?: string; icon: string; iconSize: [number, number] }
interface Props {
  content: {
    refs: { social: string; line: string; copyright: string };
    socialLabel: string;
    social: Social[];
    line: string;
    copyright: string;
  };
  links: Record<string, string>;
}
const { content, links } = Astro.props;
---
<footer class="site-footer">
  <div class="ft-social" data-ref={content.refs.social}>
    <nav aria-label={content.socialLabel}>
      <ul class="dock">
        {content.social.map((s) => {
          const href = s.href ?? links[s.link ?? ''];
          const external = /^https?:/.test(href);
          return (
            <li class="dock-item">
              <a class="dock-link" href={href} aria-label={s.label}
                {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="dock-btn">
                  <img src={s.icon} alt="" aria-hidden="true" width={s.iconSize[0]} height={s.iconSize[1]}
                    style={`width:${s.iconSize[0]}px;height:${s.iconSize[1]}px;`} />
                </span>
                <span class="dock-dot" aria-hidden="true"></span>
                <span class="dock-tip" aria-hidden="true">{s.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  <div class="ft-line" data-ref={content.refs.line} aria-hidden="true">
    <img src={content.line} alt="" width="1363" height="3" />
  </div>

  <div class="ft-copy" data-ref={content.refs.copyright}>
    <p>{content.copyright}</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; width: 100%; }

  /* ---- block 22: social dock ---- */
  .ft-social {
    display: flex; justify-content: center; align-items: center;
    height: 120px; padding: 20px 0;
  }
  .dock {
    position: relative; z-index: 1;
    display: flex; flex-direction: row; justify-content: center; align-items: flex-end; gap: 16px;
    height: 80px; padding: 8px 16px;
    background: rgb(34, 34, 34); border-radius: 90px;
    box-shadow: rgba(0, 0, 0, 0.18) 0px 0.602187px 0.602187px -1.25px, rgba(0, 0, 0, 0.16) 0px 2.28853px 2.28853px -2.5px, rgba(0, 0, 0, 0.06) 0px 10px 10px -3.75px;
  }
  .dock-item { flex: none; }
  .dock-link {
    --ease: cubic-bezier(.22, .9, .3, 1);
    position: relative; display: block; width: 48px; height: 64px;
    transition: width .45s var(--ease);
  }
  .dock-btn {
    position: absolute; left: 0; right: 0; top: 8px; height: 48px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: #000; border-radius: 90px;
    box-shadow: inset 0 0 0 1px rgba(34, 34, 34, 0);
    transition: top .45s var(--ease), height .45s var(--ease), box-shadow .45s var(--ease);
  }
  .dock-btn img { flex: none; display: block; }
  .dock-dot {
    position: absolute; left: 50%; bottom: 0; width: 8px; height: 8px; margin-left: -4px;
    background: #fff; border-radius: 50%; opacity: 0;
    transition: opacity .3s var(--ease);
  }
  .dock-tip {
    position: absolute; left: 48%; top: -36px; z-index: 1; transform: translateX(-50%);
    border-radius: 8px; pointer-events: none; opacity: 0; white-space: pre;
    font-family: var(--f-inter); font-weight: 400; font-size: 16px; line-height: 24px; color: #fff;
    box-shadow: rgba(0, 0, 0, 0.18) 0px 0.602187px 0.602187px -1.25px, rgba(0, 0, 0, 0.16) 0px 2.28853px 2.28853px -2.5px, rgba(0, 0, 0, 0.06) 0px 10px 10px -3.75px;
    transition: opacity .45s var(--ease), top .45s var(--ease), left .45s var(--ease);
  }
  .dock-link:hover, .dock-link:focus-visible { width: 72px; }
  .dock-link:hover .dock-btn, .dock-link:focus-visible .dock-btn {
    top: -24px; height: 72px; box-shadow: inset 0 0 0 1px rgb(34, 34, 34);
  }
  .dock-link:hover .dock-dot, .dock-link:focus-visible .dock-dot { opacity: 1; }
  .dock-link:hover .dock-tip, .dock-link:focus-visible .dock-tip { opacity: 1; top: -56px; left: 49%; }
  .dock-link:focus-visible { outline: none; }
  .dock-link:focus-visible .dock-btn { outline: 2px solid #fff; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .dock-link, .dock-btn, .dock-dot, .dock-tip { transition: none; }
  }

  /* ---- block 23: hairline ---- */
  .ft-line { width: 100%; height: 3px; overflow: hidden; }
  .ft-line img { display: block; width: 100%; height: 3px; }

  /* ---- block 24: copyright ---- */
  .ft-copy { display: flex; justify-content: center; align-items: center; padding: 40px 0; }
  .ft-copy p {
    width: 100%;
    font-family: var(--f-inter); font-weight: 400; font-size: 13px; line-height: 21px;
    color: rgb(104, 104, 104); text-align: center;
  }
</style>
