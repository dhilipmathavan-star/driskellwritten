---
// Footer — original blocks 22 (social dock: Framer "Dock", page.pretty.js:7230–7409, Home 29330),
// 23 (full-width hairline) and 24 (copyright). Blocks 23/24 have no motion in the source.
// The dock hover is a Framer layout animation — see the <script> for the port.
interface Social {
  label: string; href?: string; link?: string; icon: string; iconSize: [number, number];
  border: 'hover' | 'always';
}
interface Props {
  content: {
    refs: { social: string; line: string; copyright: string };
    socialLabel: string;
    social: Social[];
    line: string;
    copyright: string;
    brand?: { src: string; alt: string; width: number; height: number };
    compliance?: { label: string; badges: { src: string; alt: string }[] };
    columns?: { title: string; links: { label: string; link: string }[] }[];
  };
  links: Record<string, string>;
}
const { content, links } = Astro.props;
---
<footer class="site-footer">
  <div class="ft-social" data-ref={content.refs.social}>
    <nav aria-label={content.socialLabel}>
      <ul class="dock">
        {content.social.map((s) => {
          const href = s.href ?? links[s.link ?? ''];
          const external = /^https?:/.test(href);
          return (
            <li class="dock-item">
              <a class="dock-link" href={href} aria-label={s.label} data-border={s.border}
                {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="dock-btn" data-on={s.border === 'always' ? '' : undefined}>
                  <img src={s.icon} alt="" aria-hidden="true" width={s.iconSize[0]} height={s.iconSize[1]}
                    style={`width:${s.iconSize[0]}px;height:${s.iconSize[1]}px;`} />
                </span>
                <span class="dock-dot" aria-hidden="true"></span>
                <span class="dock-tip" aria-hidden="true">{s.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

  {content.columns && (
    <div class="ft-links">
      <div class="ft-brand">
        {content.brand && <a href="/"><img src={content.brand.src} alt={content.brand.alt} width={content.brand.width} height={content.brand.height} /></a>}
        {content.compliance && (
          <div class="ft-compliance">
            <p class="ft-colhead">{content.compliance.label}</p>
            <ul>{content.compliance.badges.map((b) => <li><img src={b.src} alt={b.alt} width="40" height="40" /></li>)}</ul>
          </div>
        )}
      </div>
      <nav class="ft-cols" aria-label="Footer">
        {content.columns.map((c) => (
          <div class="ft-col">
            <p class="ft-colhead">{c.title}</p>
            <ul>{c.links.map((l) => <li><a href={links[l.link]}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
  )}

  <div class="ft-line" data-ref={content.refs.line} aria-hidden="true">
    <img src={content.line} alt="" width="1363" height="3" />
  </div>

  <div class="ft-copy" data-ref={content.refs.copyright}>
    <p>{content.copyright}</p>
  </div>
</footer>

<script>
  // Port of the Dock hover. Source:
  //  • Dock (page.pretty.js:7230–7409): Container (layoutId bkNSLkUT0) → 4 component containers
  //    (layoutIds …-container) inside MotionConfig `Hr` = spring { stiffness 500, damping 60, mass 1 }.
  //  • Each icon is its own component — "Button Copy" X (5810–6070), "Button" Substack (6742–7116),
  //    "Button Copy 2" Instagram (5413–5724), "Button Copy 5" Mail (6076–6405) — with hover gesture
  //    (onMouseEnter/onMouseLeave, framer.pretty.js:9407) inside MotionConfig spring
  //    { stiffness 400, damping 60, mass 2 } (`Kn`/`Or`/`Pn`/`ir`).
  //    Hover CSS (e.g. 6058–6062): Icon height min-content; Container justify flex-end;
  //    Button width 48 → 72 (aspect 1); Indicator (8×8 white dot, rendered only while hovered,
  //    no exit animation) order 2; Tooltip left 48% → 49%, top −36 → −56px, translateX(−50%).
  //    Variants: Tooltip opacity 0 → 1 (+ boxShadow → none); X/Instagram Button get
  //    data-border + --border-* 0 → 1px rgb(34,34,34) (Substack/Mail always have it).
  //  • Every element has layoutId + layoutDependency, so the class change is animated by
  //    framer-motion's projection: progress spring 0 → 1000, velocity 0 (motion.pretty.js:2746–2762),
  //    each box mixed linearly from its current visual box to the new layout box relative to its
  //    projecting parent (2708–2731). The dock + component containers use `Hr`, everything inside an
  //    icon uses `Kn`. Verified frame-by-frame on the original (both springs match to <2ms).
  //  Here the same boxes are written as real layout sizes every frame (visually identical to the
  //  original's transform + scale-correction output).
  const root = document.documentElement;
  const isStatic = () => root.classList.contains('no-motion') || new URLSearchParams(location.search).has('static');

  type Phys = { stiffness: number; damping: number; mass: number };
  const DOCK: Phys = { stiffness: 500, damping: 60, mass: 1 }; // `Hr` page.pretty.js:7262
  const ICON: Phys = { stiffness: 400, damping: 60, mass: 2 }; // `Kn` page.pretty.js:5849

  // framer-motion spring (motion.pretty.js:436–520 `Le`), explicit physics, velocity 0. t in ms.
  function springGen(from: number, to: number, { stiffness, damping, mass }: Phys) {
    const g = to - from;
    const h = damping / (2 * Math.sqrt(stiffness * mass));
    const w = Math.sqrt(stiffness / mass) / 1000;
    const granular = Math.abs(g) < 5;
    const restSpeed = granular ? 0.01 : 2, restDelta = granular ? 0.005 : 0.5;
    let pos: (t: number) => number, vel: (t: number) => number;
    if (h < 1) {
      const x = w * Math.sqrt(1 - h * h), S = (h * w * g) / x;
      pos = (t) => to - Math.exp(-h * w * t) * (S * Math.sin(x * t) + g * Math.cos(x * t));
      const C = h * w * S + g * x, W = h * w * g - S * x;
      vel = (t) => Math.exp(-h * w * t) * (C * Math.sin(x * t) + W * Math.cos(x * t));
    } else if (h === 1) {
      pos = (t) => to - Math.exp(-w * t) * (g + w * g * t);
      vel = (t) => Math.exp(-w * t) * (w * w * g * t);
    } else {
      const e = w * Math.sqrt(h * h - 1);
      pos = (t) => to - (Math.exp(-h * w * t) * (h * w * g * Math.sinh(Math.min(e * t, 300)) + e * g * Math.cosh(Math.min(e * t, 300)))) / e;
      const k = (h * w * g) / e, n = h * w * k - g * e, r = h * w * g - k * e;
      vel = (t) => Math.exp(-h * w * t) * (n * Math.sinh(Math.min(e * t, 300)) + r * Math.cosh(Math.min(e * t, 300)));
    }
    return (t: number) => {
      if (t <= 0) return { value: from, done: false };
      const v = pos(t);
      const done = Math.abs(vel(t) * 1000) <= restSpeed && Math.abs(to - v) <= restDelta;
      return { value: done ? to : v, done };
    };
  }
  // accelerated values (opacity) go to WAAPI as linear() sampled from a [0,100] spring
  // (motion.pretty.js:551–558 `je`, 737–746 `ot`, 5785–5791 `Xc`)
  function springToWaapi(p: Phys) {
    const gen = springGen(0, 100, p);
    let d = 0;
    while (!gen(d).done && d < 2e4) d += 50;
    const n = Math.max(Math.round(d / 10), 2), pts: number[] = [];
    for (let i = 0; i < n; i++) pts.push(Math.round((gen(d * (i / (n - 1))).value / 100) * 1e4) / 1e4);
    return { duration: d, easing: `linear(${pts.join(', ')})` };
  }

  // layout boxes (px, relative to the projecting parent), page.pretty.js:6045–6062 + tree 1440-22
  const REST = { w: 48, by: 8, bs: 48, tx: 0.48 * 48, ty: -36 };
  const HOVER = { w: 72, by: -24, bs: 72, tx: 0.49 * 72, ty: -56 };
  type Box = typeof REST;
  const KEYS = Object.keys(REST) as (keyof Box)[];

  interface Anim { from: number; to: number; start: number; gen: ReturnType<typeof springGen> }
  const progress = (a: Anim, now: number) => {
    const r = a.gen(now - a.start);
    return { p: r.value / 1000, done: r.done };
  };

  function initDock(dock: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tipSpring = springToWaapi(ICON);
    const items = [...dock.querySelectorAll<HTMLElement>('.dock-item')].map((li) => {
      const link = li.querySelector<HTMLElement>('.dock-link')!;
      return {
        li, link,
        btn: link.querySelector<HTMLElement>('.dock-btn')!,
        tip: link.querySelector<HTMLElement>('.dock-tip')!,
        borderOnHover: link.dataset.border === 'hover',
        hovered: false,
        // component container width (Dock tree, `Hr`)
        cw: 48, cwA: null as Anim | null,
        // icon internals (`Kn`): current visual box + animation
        box: { ...REST } as Box, boxFrom: { ...REST } as Box, boxTo: { ...REST } as Box, boxA: null as Anim | null,
        // --border-* variables (JS spring, `Kn`): width px and colour progress
        bw: 0, bwA: null as Anim | null, bc: 0, bcA: null as Anim | null,
        tipAnim: null as Animation | null,
      };
    });
    type Item = typeof items[number];
    let raf = 0;

    const render = (it: Item) => {
      it.li.style.width = `${it.cw}px`;
      it.link.style.width = `${it.box.w}px`;
      it.btn.style.top = `${it.box.by}px`;
      it.btn.style.width = it.btn.style.height = `${it.box.bs}px`;
      it.tip.style.left = `${it.box.tx}px`;
      it.tip.style.top = `${it.box.ty}px`;
      if (it.borderOnHover) {
        // colour rgba(0,0,0,0) → rgb(34,34,34): channels mixed in squared space, alpha linear
        const c = Math.round(Math.sqrt(it.bc * 34 * 34));
        it.btn.style.setProperty('--bw', `${it.bw}px`);
        it.btn.style.setProperty('--bc', `rgba(${c}, ${c}, ${c}, ${Math.round(it.bc * 1e5) / 1e5})`);
      }
    };
    const frame = () => {
      raf = 0;
      const now = performance.now();
      let again = false;
      for (const it of items) {
        if (it.cwA) {
          const { p, done } = progress(it.cwA, now);
          it.cw = it.cwA.from + (it.cwA.to - it.cwA.from) * p;
          if (done) it.cwA = null; else again = true;
        }
        if (it.boxA) {
          const { p, done } = progress(it.boxA, now);
          for (const k of KEYS) it.box[k] = it.boxFrom[k] + (it.boxTo[k] - it.boxFrom[k]) * p;
          if (done) it.boxA = null; else again = true;
        }
        if (it.bwA) {
          const r = it.bwA.gen(now - it.bwA.start); it.bw = r.value;
          if (r.done) it.bwA = null; else again = true;
        }
        if (it.bcA) {
          const r = it.bcA.gen(now - it.bcA.start);
          it.bc = it.bcA.from + (it.bcA.to - it.bcA.from) * (r.value / 100);
          if (r.done) it.bcA = null; else again = true;
        }
        render(it);
      }
      if (again) raf = requestAnimationFrame(frame);
    };

    const setHover = (it: Item, on: boolean) => {
      if (it.hovered === on) return;
      it.hovered = on;
      const now = performance.now();
      it.link.classList.toggle('is-hover', on); // dot shown / hidden at once (no exit animation)
      if (it.borderOnHover) it.btn.toggleAttribute('data-on', on); // data-border only while hovered
      const target = on ? HOVER : REST;
      if (reduce) {
        it.cw = target.w; it.box = { ...target }; it.bw = on ? 1 : 0; it.bc = on ? 1 : 0;
        it.tip.style.opacity = on ? '1' : '0';
        render(it);
        return;
      }
      // Dock tree (`Hr`): component container 48 ↔ 72, from its current visual width
      it.cwA = { from: it.cw, to: target.w, start: now, gen: springGen(0, 1000, DOCK) };
      // icon internals (`Kn`): every box from where it is now to the new layout
      it.boxFrom = { ...it.box }; it.boxTo = { ...target };
      it.boxA = { from: 0, to: 1000, start: now, gen: springGen(0, 1000, ICON) };
      if (it.borderOnHover) {
        it.bwA = { from: it.bw, to: on ? 1 : 0, start: now, gen: springGen(it.bw, on ? 1 : 0, ICON) };
        it.bcA = { from: it.bc, to: on ? 1 : 0, start: now, gen: springGen(0, 100, ICON) };
      }
      // tooltip opacity (accelerated → WAAPI) from its current value
      const cur = parseFloat(getComputedStyle(it.tip).opacity);
      it.tipAnim?.cancel();
      it.tip.style.opacity = on ? '1' : '0';
      it.tipAnim = it.tip.animate({ opacity: [cur, on ? 1 : 0] }, { duration: tipSpring.duration, easing: tipSpring.easing, fill: 'none' });
      render(it);
      if (!raf) raf = requestAnimationFrame(frame);
    };

    for (const it of items) {
      it.link.addEventListener('mouseenter', () => setHover(it, true));
      it.link.addEventListener('mouseleave', () => setHover(it, false));
    }
  }

  if (!isStatic()) document.querySelectorAll<HTMLElement>('.dock').forEach(initDock);
</script>

<style>
  .site-footer { position: relative; width: 100%; }
  /* link columns + compliance badges, in the copyright line's type (Inter 13/21, rgb(104,104,104)) */
  .ft-links {
    max-width: 1440px; margin: 0 auto; padding: 40px 40px 48px;
    display: flex; justify-content: space-between; align-items: flex-start; gap: 40px;
  }
  .ft-brand { display: flex; flex-direction: column; gap: 24px; }
  .ft-brand img { display: block; height: 24px; width: auto; }
  .ft-colhead { margin-bottom: 12px; font: 500 13px/21px var(--f-inter); color: #fff; }
  .ft-compliance ul { display: flex; gap: 12px; }
  .ft-compliance img { width: 40px; height: 40px; opacity: 0.7; }
  .ft-cols { display: flex; gap: 80px; }
  .ft-col ul { display: flex; flex-direction: column; gap: 8px; }
  .ft-col a { font: 400 13px/21px var(--f-inter); color: rgb(104, 104, 104); transition: color 0.2s; }
  .ft-col a:hover { color: #fff; }
  @media (max-width: 809px) {
    .ft-links { flex-direction: column; padding: 32px 20px; }
    .ft-cols { flex-wrap: wrap; gap: 32px; }
  }


  /* ---- block 22: social dock ---- */
  .ft-social {
    display: flex; justify-content: center; align-items: center;
    height: 120px; padding: 20px 0;
  }
  .dock {
    position: relative; z-index: 1;
    display: flex; flex-direction: row; justify-content: center; align-items: flex-end; gap: 16px;
    height: 80px; padding: 8px 16px;
    background: rgb(34, 34, 34); border-radius: 90px;
    box-shadow: rgba(0, 0, 0, 0.18) 0px 0.602187px 0.602187px -1.25px, rgba(0, 0, 0, 0.16) 0px 2.28853px 2.28853px -2.5px, rgba(0, 0, 0, 0.06) 0px 10px 10px -3.75px;
  }
  /* component container (width animated by the script) */
  .dock-item { position: relative; flex: none; width: 48px; height: 64px; }
  /* "Icon" + "Container": 64px tall, button/dot/tooltip positioned from its top-left */
  .dock-link { position: absolute; left: 0; top: 0; display: block; width: 48px; height: 64px; cursor: pointer; }
  .dock-btn {
    position: absolute; left: 0; top: 8px; width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: #000; border-radius: 90px;
  }
  /* [data-border="true"]::after rule of the button components (e.g. page.pretty.js:6063) */
  .dock-btn[data-on]::after {
    content: ""; position: absolute; inset: 0; box-sizing: border-box; border-radius: inherit; pointer-events: none;
    border: var(--bw, 1px) solid var(--bc, rgb(34, 34, 34));
  }
  .dock-btn img { flex: none; display: block; }
  .dock-dot {
    display: none; position: absolute; left: 32px; top: 56px; width: 8px; height: 8px;
    background: #fff; border-radius: 90px;
  }
  .dock-link.is-hover .dock-dot { display: block; }
  .dock-tip {
    position: absolute; left: 23.04px; top: -36px; z-index: 1; transform: translateX(-50%);
    border-radius: 8px; pointer-events: none; opacity: 0; white-space: pre; overflow: hidden;
    font-family: var(--f-inter); font-weight: 400; font-size: 16px; line-height: 24px; color: #fff;
    box-shadow: rgba(0, 0, 0, 0.18) 0px 0.602187px 0.602187px -1.25px, rgba(0, 0, 0, 0.16) 0px 2.28853px 2.28853px -2.5px, rgba(0, 0, 0, 0.06) 0px 10px 10px -3.75px;
  }
  .dock-link.is-hover .dock-tip { box-shadow: none; }
  .dock-link:focus-visible { outline: none; }
  .dock-link:focus-visible .dock-btn { outline: 2px solid #fff; outline-offset: 2px; }

  /* ---- block 23: hairline ---- */
  .ft-line { width: 100%; height: 3px; overflow: hidden; }
  .ft-line img { display: block; width: 100%; height: 3px; }

  /* ---- block 24: copyright ---- */
  .ft-copy { display: flex; justify-content: center; align-items: center; padding: 40px 0; }
  .ft-copy p {
    width: 100%;
    font-family: var(--f-inter); font-weight: 400; font-size: 13px; line-height: 21px;
    color: rgb(104, 104, 104); text-align: center;
  }
</style>
